// виділення рядку
tbody.addEventListener("click", function(e) {
    var clickedRow = e.target.closest("tr");
    if (!clickedRow) return;
    var currentActiveRow = tbody.querySelector(".active");
    if (currentActiveRow && currentActiveRow !== clickedRow) currentActiveRow.classList.remove("active");
    clickedRow.classList.toggle("active");
});
