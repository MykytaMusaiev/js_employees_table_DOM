// повідомлення
var pushNotification = function(posTop, posRight, title, description, type) {
    var notification = document.createElement("div");
    notification.className = "notification ".concat(type);
    notification.dataset.qa = "notification";
    notification.style.position = "absolute";
    notification.style.top = "".concat(posTop, "px");
    notification.style.right = "".concat(posRight, "px");
    var h2 = document.createElement("h2");
    h2.className = "title";
    h2.textContent = title;
    var p = document.createElement("p");
    p.textContent = description;
    notification.append(h2, p);
    document.body.append(notification);
    setTimeout(function() {
        notification.style.display = "none";
    }, 2000);
};
// сортування
var lastSortedColumn = -1;
var sortDirection = "asc";
var tbody = document.querySelector("tbody");
var tHead = document.querySelector("thead");
tHead.addEventListener("click", function(e) {
    var _tbody;
    if (e.target.tagName !== "TH") return;
    var clickedIndex = e.target.cellIndex;
    if (clickedIndex === lastSortedColumn) sortDirection = sortDirection === "asc" ? "desc" : "asc";
    else sortDirection = "asc";
    lastSortedColumn = clickedIndex;
    var rows = Array.from(tbody.querySelectorAll("tr"));
    rows.sort(function(a, b) {
        var textA = a.children[clickedIndex].textContent;
        var textB = b.children[clickedIndex].textContent;
        var direction = sortDirection === "asc" ? 1 : -1;
        switch(clickedIndex){
            case 3:
                return (parseInt(textA, 10) - parseInt(textB, 10)) * direction;
            case 4:
                return (parseSalary(textA) - parseSalary(textB)) * direction;
